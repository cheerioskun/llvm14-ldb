+
+/* A TCP write may batch responses belonging to different requests. Preserve
+ * batching and leave that shared work unassigned. A sole response owns its
+ * context across partial-write retries; never use the connection's last ID.
+ */
+static enum transmit_result transmit(conn *c) {
+    mc_resp *resp = c->resp_head;
+    if (resp && !resp->next && !resp->skip && resp->ldb_response_tag_valid) {
+        ldb_tag_set(resp->ldb_response_tag);
+    } else {
+        ldb_tag_clear();
+    }
+    enum transmit_result result = transmit_tcp(c);
+    ldb_tag_clear();
+    return result;
 }
 
